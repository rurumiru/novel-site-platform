APP_NAME=ER.IIIBA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=redis

# Демо-стенд: при true планировщик каждые 15 минут удаляет весь контент,
# не помеченный как демонстрационный (is_demo). Включать ТОЛЬКО на изолированном
# демо-окружении — на боевом сервере это удалит реальные данные.
DEMO_MODE=false
# DEMO_ADMIN_EMAIL=admin@demo.iiiba.ru
# DEMO_ADMIN_PASSWORD=demo12345

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ──────────────────────────────────────────────────────────────────────────────
# PostgreSQL — основной коннект
# ──────────────────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=forge
DB_PASSWORD=
DB_CHARSET=utf8
DB_SEARCH_PATH=public
DB_SSLMODE=prefer
DB_APP_NAME=laravel

# Дополнительный домен → отдельная БД на том же PG-сервере
DB_BETA_HOST=127.0.0.1
DB_BETA_PORT=5432
DB_BETA_DATABASE=laravel_beta
DB_BETA_USERNAME=forge
DB_BETA_PASSWORD=
DB_BETA_SSLMODE=prefer
# DB_BETA_SEARCH_PATH=public

# ──────────────────────────────────────────────────────────────────────────────
# Redis 7.2 — кэш / сессии / очереди / Horizon
# ──────────────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_HORIZON_DB=4
# Префикс по умолчанию вычисляется из APP_NAME; задайте явный, если делите Redis с другим проектом:
# REDIS_PREFIX=laravel_
REDIS_CLUSTER=redis
REDIS_PERSISTENT=false
REDIS_READ_TIMEOUT=60

# ──────────────────────────────────────────────────────────────────────────────
# Cache / session / queue — все на Redis
# ──────────────────────────────────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=session

QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

# Horizon — соединение в Redis (если пакет laravel/horizon установлен)
HORIZON_PREFIX=horizon:

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3

# ──────────────────────────────────────────────────────────────────────────────
# Mail
# ──────────────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────────────────────────────────────────────────────
# S3 (S3-совместимое хранилище)
# ──────────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your-bucket
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
